    {
      "type": "timeseries",
      "title": "consumer lag",
      "description": "30초마다 워커가 계산. 계속 늘면 워커가 못 따라가거나 멈춘 것",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (review_worker_consumer_lag)",
          "legendFormat": "{{topic}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "id": 15
    },
    {
      "type": "stat",
      "title": "생존 파일 갱신 뒤 지난 시간",
      "description": "120초를 넘으면 livenessProbe 가 재시작한다",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(review_worker_last_heartbeat_timestamp)",
          "legendFormat": "worker",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "textMode": "auto"
      },
      "gridPos": {
        "x": 8,
        "y": 35,
        "w": 4,
        "h": 8
      },
      "id": 16
    },
    {
