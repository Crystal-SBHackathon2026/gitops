{
  "title": "앱 상태 — sample-app",
  "uid": "apps-sample-app",
  "tags": [
    "apps",
    "sample-app"
  ],
  "timezone": "Asia/Seoul",
  "editable": true,
  "schemaVersion": 41,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "데이터소스",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0
      },
      {
        "name": "env",
        "label": "환경",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": "label_values(http_requests_total{app=\"sample-app\"}, env)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "지금 무엇이 떠 있나",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "파드별 이미지 태그 — 지금 뜬 게 어느 커밋인가",
      "description": "지표 라벨에 커밋 SHA 를 넣지 않는다 (배포마다 시계열이 새로 생긴다). 커밋은 kube_pod_container_info 로 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "kube_pod_container_info{namespace=\"sample-app\", container=\"sample-app\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "container": true,
              "container_id": true,
              "endpoint": true,
              "image_id": true,
              "image_spec": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "service": true,
              "uid": true
            },
            "renameByName": {
              "pod": "파드",
              "image": "이미지"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Argo CD — 동기화·상태",
      "description": "argocd_app_info 는 sync_status·health_status 를 라벨로 들고 1 을 낸다. 범례가 지금 상태다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (name, sync_status, health_status) (argocd_app_info{name=~\"sample-app.*\"})",
          "legendFormat": "{{name}} — {{sync_status}} / {{health_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "stepAfter": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "row",
      "title": "카나리",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "🔴 카나리 파드 vs 안정 파드 — 5xx 비율",
      "description": "rollouts_pod_template_hash 로 갈라야 '새 버전만 에러가 난다' 가 보인다. 합치면 안정 파드의 정상 응답에 희석된다.\n\n/healthz 는 빼고 센다 — 5초·10초마다 때려서 사용자 요청 실패가 묻힌다.\n\n에러가 없을 때 빈 패널이 되지 않게 or (… * 0) 으로 0 선을 남긴다. 그래도 비어 있으면 사용자 요청 자체가 없는 것이다 — 아래 '요청률' 패널을 보라.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "(\n  sum by (rollouts_pod_template_hash) (rate(http_requests_total{app=\"sample-app\", env=~\"$env\", route!=\"/healthz\", status=~\"5..\"}[1m]))\n  or\n  (sum by (rollouts_pod_template_hash) (rate(http_requests_total{app=\"sample-app\", env=~\"$env\", route!=\"/healthz\"}[1m])) * 0)\n)\n/\nsum by (rollouts_pod_template_hash) (rate(http_requests_total{app=\"sample-app\", env=~\"$env\", route!=\"/healthz\"}[1m]))",
          "legendFormat": "{{rollouts_pod_template_hash}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Rollout 단계와 복제본",
      "description": "rollout_phase 는 단계마다 0/1 을 낸다. 1 인 줄이 지금 단계다. 복제본은 카나리 가중치가 파드 수로 환산된 결과다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (phase) (rollout_phase{name=\"sample-app\"})",
          "legendFormat": "단계 {{phase}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(rollout_info_replicas_desired{name=\"sample-app\"})",
          "legendFormat": "복제본 목표"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(rollout_info_replicas_updated{name=\"sample-app\"})",
          "legendFormat": "새 버전"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(rollout_info_replicas_available{name=\"sample-app\"})",
          "legendFormat": "서비스 가능"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(rollout_info_replicas_unavailable{name=\"sample-app\"})",
          "legendFormat": "불가"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "stepAfter": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "앱 응답",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "요청률 (경로별)",
      "description": "경로는 express 가 매칭한 라우트 이름만 쓴다. 없는 경로는 route=\"unmatched\" 하나로 모인다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (route) (rate(http_requests_total{app=\"sample-app\", env=~\"$env\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "timeseries",
      "title": "응답 코드별",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (status) (rate(http_requests_total{app=\"sample-app\", env=~\"$env\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "5.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "timeseries",
      "title": "처리 시간 (p50 · p95)",
      "description": "버킷은 0.005초부터 2.5초까지다. 이 앱은 계산이 없어 대부분 10ms 안에 끝난다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{app=\"sample-app\", env=~\"$env\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{app=\"sample-app\", env=~\"$env\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "row",
      "title": "프로세스",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "collapsed": true,
      "panels": [
        {
          "type": "timeseries",
          "title": "메모리 (힙)",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "gridPos": {
            "h": 7,
            "w": 8,
            "x": 0,
            "y": 29
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${ds}"
              },
              "expr": "sum by (pod) (nodejs_heap_size_used_bytes{app=\"sample-app\", env=~\"$env\"})",
              "legendFormat": "{{pod}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "min": 0
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "title": "이벤트 루프 지연",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "gridPos": {
            "h": 7,
            "w": 8,
            "x": 8,
            "y": 29
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${ds}"
              },
              "expr": "max by (pod) (nodejs_eventloop_lag_p99_seconds{app=\"sample-app\", env=~\"$env\"})",
              "legendFormat": "{{pod}} p99"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "min": 0
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "title": "CPU",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "gridPos": {
            "h": 7,
            "w": 8,
            "x": 16,
            "y": 29
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${ds}"
              },
              "expr": "sum by (pod) (rate(process_cpu_seconds_total{app=\"sample-app\", env=~\"$env\"}[2m]))",
              "legendFormat": "{{pod}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0
            },
            "overrides": []
          }
        }
      ]
    }
  ]
}
